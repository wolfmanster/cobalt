PORT=4100
HOST=127.0.0.1
COBALT_URL=http://127.0.0.1:9000
# COBALT_API_KEY=
# 同时解析的帖子数
RESOLVE_CONCURRENCY=4
# 同时进入下载阶段的帖子数
DOWNLOAD_CONCURRENCY=2
# 每条帖子内同时下载的媒体数
MEDIA_DOWNLOAD_CONCURRENCY=2
# DATA_DIR=../../data
# CLIENT_DIST=../client/dist
# Generate once with `openssl rand -hex 32`; keep the same key across restarts.
# X_SESSION_ENCRYPTION_KEY=replace-with-64-hex-characters
# ARCHIVE_USERNAME=archive
# ARCHIVE_PASSWORD=replace-with-a-long-unique-password
# Optional for a loopback-only HTTP development server. Keep unset for HTTPS.
# ARCHIVE_INSECURE_LOOPBACK=1
