# Public URL of this Cobalt processing instance.
API_URL=http://localhost:9000/

# Local development defaults.
API_PORT=9000
API_LISTEN_ADDRESS=127.0.0.1

# Allow the local web frontend to call the API.
CORS_WILDCARD=1

# For a public deployment, configure at least API_AUTH_REQUIRED=1 together
# with API_KEY_URL, or enable Turnstile with TURNSTILE_SITEKEY, TURNSTILE_SECRET
# and a JWT_SECRET of at least 16 characters. See docs/api-env-variables.md.
